<svg width="400" height="800" viewBox="0 0 400 800" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="400" height="800" rx="36" fill="#0A0E1A"/>
  <rect x="2" y="2" width="396" height="796" rx="34" stroke="rgba(16,185,129,0.25)" stroke-width="2"/>
  
  <!-- Status pill -->
  <rect x="100" y="40" width="200" height="36" rx="18" fill="rgba(16,185,129,0.15)" stroke="#10B981" stroke-width="1.5"/>
  <text x="200" y="63" text-anchor="middle" fill="#10B981" font-family="'Plus Jakarta Sans', sans-serif" font-size="14" font-weight="800">⏱️ ON-TIME GUARANTEE</text>
  
  <!-- Clock / Key Icon -->
  <circle cx="200" cy="160" r="60" fill="rgba(16,185,129,0.1)"/>
  <circle cx="200" cy="160" r="46" fill="rgba(16,185,129,0.2)" stroke="#10B981" stroke-width="2"/>
  <text x="200" y="174" text-anchor="middle" font-size="44">🔑</text>
  
  <!-- Title -->
  <text x="200" y="260" text-anchor="middle" fill="#FFFFFF" font-family="'Plus Jakarta Sans', sans-serif" font-size="24" font-weight="900">Doorstep Arrival</text>
  <text x="200" y="290" text-anchor="middle" fill="rgba(255,255,255,0.65)" font-family="'Plus Jakarta Sans', sans-serif" font-size="15" font-weight="500">Chauffeur arrives 10 mins early</text>
  
  <!-- Punctuality Features -->
  <g transform="translate(30, 330)">
    <rect width="340" height="72" rx="18" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.1)"/>
    <text x="36" y="45" font-size="26">🚪</text>
    <text x="75" y="32" fill="#fff" font-family="'Plus Jakarta Sans', sans-serif" font-size="16" font-weight="700">Right at Your Gate</text>
    <text x="75" y="52" fill="#10B981" font-family="'Plus Jakarta Sans', sans-serif" font-size="13">No walking to main roads</text>
  </g>
  
  <g transform="translate(30, 418)">
    <rect width="340" height="72" rx="18" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.1)"/>
    <text x="36" y="45" font-size="26">👔</text>
    <text x="75" y="32" fill="#fff" font-family="'Plus Jakarta Sans', sans-serif" font-size="16" font-weight="700">Formal Attire & Courtesy</text>
    <text x="75" y="52" fill="#10B981" font-family="'Plus Jakarta Sans', sans-serif" font-size="13">White gloves • Door opened for you</text>
  </g>
  
  <g transform="translate(30, 506)">
    <rect width="340" height="72" rx="18" fill="rgba(255,255,255,0.05)" stroke="rgba(255,255,255,0.1)"/>
    <text x="36" y="45" font-size="26">📋</text>
    <text x="75" y="32" fill="#fff" font-family="'Plus Jakarta Sans', sans-serif" font-size="16" font-weight="700">12-Point Pre-Drive Check</text>
    <text x="75" y="52" fill="#10B981" font-family="'Plus Jakarta Sans', sans-serif" font-size="13">Tires, fuel level, mirrors adjusted</text>
  </g>
  
  <!-- On-Time Metric -->
  <g transform="translate(30, 600)">
    <rect width="340" height="140" rx="22" fill="rgba(16,185,129,0.12)" stroke="#10B981" stroke-width="1.5"/>
    <text x="24" y="38" fill="#10B981" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="800" letter-spacing="1">PUNCTUALITY RECORD</text>
    <text x="24" y="72" fill="#FFFFFF" font-family="'Plus Jakarta Sans', sans-serif" font-size="28" font-weight="900">99.8% On-Time</text>
    <text x="24" y="98" fill="rgba(255,255,255,0.7)" font-family="'Plus Jakarta Sans', sans-serif" font-size="14">Average arrival 6.4 minutes early</text>
    <text x="24" y="122" fill="#10B981" font-family="'Plus Jakarta Sans', sans-serif" font-size="14" font-weight="700">✓ If late &gt;5m, your ride is free</text>
  </g>
</svg>
